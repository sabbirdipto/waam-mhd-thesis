# --- upstream clones: not our code, don't vendor them ---
src/laserbeamFoam/
ext/

# --- OpenFOAM build artifacts ---
**/platforms/
**/lnInclude/
**/Make/linux*
*.dep
*.o
*.so

# --- case run output ---
**/processor*/
**/postProcessing/
**/VTK/
**/VTKs/
**/*.foam
**/constant/polyMesh/
log.*

# time directories (0.001, 1.5, 10, 200 ...) but KEEP initial conditions
**/[0-9]*.[0-9]*/
**/[1-9][0-9]*/
**/[1-9]/
!**/0/
!**/0.orig/

# --- misc ---
runs/output/
*.tar
*.tar.gz
core.*
*:Zone.Identifier

# distilled evidence IS tracked (small summaries, checker output)
!results/

# --- OpenFOAM case output (added when droplet runs began) ------------
# Allrun regenerates all of this from initial/, constant/, system/.
# NOTE: the obvious pattern [0-9]*/ would also match cases/00-tutorials/
# and silently ignore the whole case tree. These match only real numbers.
0/
[0-9].[0-9]*/
[0-9][0-9].[0-9]*/
[0-9]e-[0-9]*/
[0-9].[0-9]*e-[0-9]*/
processor*/
**/constant/polyMesh/
postProcessing/
log.*
logs/
*.foam
*.OpenFOAM

# generated tables inside case dirs; curated ones go in results/
cases/**/stats.*
cases/**/mass.*

# backups written by tools/patch_*.py
*.dbak
*.kbak
*.hbak
*.bak
*.orig

# build artefacts
**/Make/linux*/
**/lnInclude/
*.o
*.so
*.dep
__pycache__/
*.pyc
src/laserbeamFoam.upstream-DO-NOT-BUILD/

# --- appended 2026-09-19 ---------------------------------------------
# '*.orig' above was meant for patch backups, but it also matches every
# case's 0.orig/ template (the initial conditions). Re-include it: in
# .gitignore the LAST matching rule wins.
!0.orig/
!**/0.orig/**
# patch backups with other suffixes (.drbak from patch_droplet_restart.py)
*bak
# coded-object builds, stray logs, scratch cases (zz- prefix = never committed)
dynamicCode/
nohup.out
cases/**/zz-*/
# cell-centre and volume fields: derived from the mesh, regenerated by
# Allrun's writeCellCentres/writeCellVolumes. Placed after the 0.orig
# re-include so they win (last matching rule).
**/0.orig/C
**/0.orig/C[xyz]
**/0.orig/V
**/0/C
**/0/C[xyz]
**/0/V
cases/**/system/controlDict.*
cases/**/bead_profile_*.csv
