// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
FoamFile
{
    version         2;
    format          ascii;
    class           dictionary;
    location        "system";
    object          controlDict;
}

libs            ( "libthermoTools.so" );

application     laserbeamFoam;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         1.2;

deltaT          1e-05;

writeControl    adjustableRunTime;

writeInterval   0.02;

purgeWrite      0;

writeFormat     ascii;

writePrecision  10;

writeCompression off;

timeFormat      general;

timePrecision   10;

runTimeModifiable yes;

adjustTimeStep  yes;

maxCo           0.1;

maxAlphaCo      0.1;

maxDeltaT       1e-05;



functions
{
    gasFlux
    {
        // Volumetric flow through the top patch, every write. While the
        // nozzle is fully inside the domain this must equal -gas_Q_m3_s;
        // it drops when the nozzle overhangs an x boundary.
        type            surfaceFieldValue;
        libs            ("libfieldFunctionObjects.so");
        fields          (phi);
        operation       sum;
        regionType      patch;
        name            inlet;
        writeControl    writeTime;
        writeFields     false;
        log             true;
    }
}

