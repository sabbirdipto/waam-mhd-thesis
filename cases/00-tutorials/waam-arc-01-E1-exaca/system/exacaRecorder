/*---------------------------------------------------------------------------*\
  exacaRecorder: ExaCA thermal-history recorder (WAAM-MHD thesis)

  Every time step, every cell. Liquid metal = alpha.metal > 0.5 and T >= 906 K.
  One CSV row per completed melt -> solidify event:
    x,y,z  cell centre [m]
    tm     became liquid metal [s]: interpolated 906 K crossing if it melted in
           place; arrival time if metal arrived molten; -1 if already molten
           when this run segment started
    tl     cooled back through 906 K [s], interpolated
    cr     10 K / (time from 906 K to 896 K) [K/s]
    G      |grad T| at tl [K/m]
  A dip below 906 K that re-melts before 896 K is not solidification.
  Metal leaving a cell drops its open event.
  Output: postProcessing/exacaRecorder/events_p<rank>_from<startTime>.csv
  Reads T and alpha.metal only. Physics unchanged.
\*---------------------------------------------------------------------------*/
exacaRecorder
{
    type            coded;
    libs            (utilityFunctionObjects);
    name            exacaRecorder;
    executeControl  timeStep;
    executeInterval 1;
    writeControl    writeTime;

    codeInclude
    #{
        #include "fvCFD.H"
        #include "OSspecific.H"
        #include <fstream>
        #include <sstream>
        #include <iomanip>
        #include <string>
    #};

    codeOptions
    #{
        -I$(LIB_SRC)/finiteVolume/lnInclude \
        -I$(LIB_SRC)/meshTools/lnInclude
    #};

    codeLibs
    #{
        -lfiniteVolume \
        -lmeshTools
    #};

    codeExecute
    #{
        const scalar TL   = 906.0;
        const scalar dTcr = 10.0;
        const scalar aMin = 0.5;
        static label nEvents = 0, nDropped = 0;

        const fvMesh& m = mesh();
        const volScalarField& T = m.lookupObject<volScalarField>("T");
        const volScalarField& a = m.lookupObject<volScalarField>("alpha.metal");
        const scalar t  = m.time().value();
        const scalar dt = m.time().deltaTValue();

        if (!m.foundObject<volScalarField>("exaState"))
        {
            const char* names[6] = {"exaState","exaTprev","exaAprev","exaTm","exaTl","exaG"};
            const scalar init[6] = {0, 0, 0, -1, -1, 0};
            for (int k = 0; k < 6; ++k)
            {
                volScalarField* p = new volScalarField
                (
                    IOobject(word(names[k]), m.time().timeName(), m,
                             IOobject::NO_READ, IOobject::NO_WRITE),
                    m,
                    dimensionedScalar(dimless, init[k])
                );
                p->store();
            }
            scalarField& S0 = m.lookupObjectRef<volScalarField>("exaState").primitiveFieldRef();
            m.lookupObjectRef<volScalarField>("exaTprev").primitiveFieldRef() = T.primitiveField();
            m.lookupObjectRef<volScalarField>("exaAprev").primitiveFieldRef() = a.primitiveField();
            forAll(S0, i)
            {
                if (a[i] > aMin && T[i] >= TL) { S0[i] = 1; }
            }
            Info<< "exacaRecorder: recording from t = " << m.time().timeName()
                << "  (TL " << TL << " K, cr window " << dTcr << " K)" << endl;
            return true;
        }

        scalarField& S  = m.lookupObjectRef<volScalarField>("exaState").primitiveFieldRef();
        scalarField& Tp = m.lookupObjectRef<volScalarField>("exaTprev").primitiveFieldRef();
        scalarField& Ap = m.lookupObjectRef<volScalarField>("exaAprev").primitiveFieldRef();
        scalarField& Tm = m.lookupObjectRef<volScalarField>("exaTm").primitiveFieldRef();
        scalarField& Tl = m.lookupObjectRef<volScalarField>("exaTl").primitiveFieldRef();
        scalarField& Gs = m.lookupObjectRef<volScalarField>("exaG").primitiveFieldRef();

        // collective in parallel: every rank computes it every step
        const scalarField gradTmag(mag(fvc::grad(T))().primitiveField());
        const vectorField& Cc = m.C().primitiveField();

        std::ostringstream buf;
        buf << std::setprecision(10);

        forAll(S, i)
        {
            const scalar T0 = Tp[i];
            const scalar T1 = T[i];
            const bool metal    = a[i]  > aMin;
            const bool wasMetal = Ap[i] > aMin;
            const label s = label(S[i] + 0.5);

            if (s == 0)
            {
                if (metal && T1 >= TL)
                {
                    Tm[i] = (wasMetal && T0 < TL && T1 > T0)
                          ? t - dt + dt*(TL - T0)/(T1 - T0)
                          : t;
                    S[i] = 1;
                }
            }
            else if (!metal)
            {
                S[i] = 0; Tm[i] = -1; Tl[i] = -1; ++nDropped;
            }
            else if (s == 1)
            {
                if (T1 < TL)
                {
                    Tl[i] = (T0 > T1) ? t - dt + dt*(T0 - TL)/(T0 - T1) : t;
                    Gs[i] = gradTmag[i];
                    S[i]  = 2;
                }
            }
            else
            {
                if (T1 >= TL)
                {
                    S[i] = 1;
                }
                else if (T1 <= TL - dTcr)
                {
                    const scalar Tx = TL - dTcr;
                    const scalar tx = (T0 > Tx && T0 > T1)
                                    ? t - dt + dt*(T0 - Tx)/(T0 - T1)
                                    : t;
                    const scalar cr = dTcr/max(tx - Tl[i], dt);
                    buf << Cc[i].x() << ',' << Cc[i].y() << ',' << Cc[i].z() << ','
                        << Tm[i] << ',' << Tl[i] << ',' << cr << ',' << Gs[i] << '\n';
                    ++nEvents;
                    S[i] = 0; Tm[i] = -1; Tl[i] = -1;
                }
            }
        }
        Tp = T.primitiveField();
        Ap = a.primitiveField();

        if (!buf.str().empty())
        {
            const fileName dir(m.time().globalPath()/"postProcessing"/"exacaRecorder");
            mkDir(dir);
            const std::string fn =
                std::string(dir) + "/events_p" + std::to_string(Pstream::myProcNo())
              + "_from" + Time::timeName(m.time().startTime().value()) + ".csv";
            const bool fresh = !isFile(fileName(fn));
            std::ofstream f(fn, std::ios::app);
            if (fresh) { f << "x,y,z,tm,tl,cr,G\n"; }
            f << buf.str();
        }

        if (m.time().writeTime())
        {
            label nOpen = 0;
            forAll(S, i) { if (S[i] > 0.5) { ++nOpen; } }
            Info<< "exacaRecorder: " << returnReduce(nEvents, sumOp<label>())
                << " events, " << returnReduce(nOpen, sumOp<label>())
                << " cells molten or cooling, " << returnReduce(nDropped, sumOp<label>())
                << " dropped (metal left)" << endl;
        }
    #};
}
